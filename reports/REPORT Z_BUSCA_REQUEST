*&---------------------------------------------------------------------*
*& Report  Z_BUSCA_REQUEST
*&---------------------------------------------------------------------*
REPORT z_busca_request.

TYPES: BEGIN OF ty_task,
         task         TYPE e070-trkorr,
         request      TYPE e070-trkorr,
         owner        TYPE e070-as4user,
         task_text    TYPE e07t-as4text,
         request_text TYPE e07t-as4text,
         has_objects  TYPE char1,
       END OF ty_task.

DATA: lt_tasks TYPE STANDARD TABLE OF ty_task,
      ls_task  TYPE ty_task.

DATA: lt_output   TYPE STANDARD TABLE OF string,
      lv_line     TYPE string,
      lv_fullpath TYPE string,
      lv_status   TYPE string.

DATA: lt_with_objects TYPE SORTED TABLE OF e071-trkorr
                        WITH UNIQUE KEY table_line.

PARAMETERS: p_user TYPE e070-as4user DEFAULT sy-uname,
            p_file TYPE string DEFAULT 'C:\temp\tasks_usuario.txt'.

START-OF-SELECTION.

  " Busca tasks do usuário
  " Task = registro em E070 com STRKORR preenchido
  " STRKORR = request pai
  SELECT tas~trkorr      AS task,
         tas~strkorr     AS request,
         tas~as4user     AS owner,
         txt_tas~as4text AS task_text,
         txt_req~as4text AS request_text
    FROM e070 AS tas
    LEFT OUTER JOIN e07t AS txt_tas
      ON txt_tas~trkorr = tas~trkorr
     AND txt_tas~langu  = @sy-langu
    LEFT OUTER JOIN e07t AS txt_req
      ON txt_req~trkorr = tas~strkorr
     AND txt_req~langu  = @sy-langu
    INTO CORRESPONDING FIELDS OF TABLE @lt_tasks
   WHERE tas~strkorr IS NOT INITIAL
     AND tas~as4user  = @p_user
     AND tas~trstatus = 'D'
   ORDER BY tas~trkorr.

  IF lt_tasks IS INITIAL.
    MESSAGE 'Nenhuma task modificável encontrada para o usuário.' TYPE 'S' DISPLAY LIKE 'W'.
    RETURN.
  ENDIF.

  " Descobre quais tasks possuem objetos em E071
  SELECT DISTINCT trkorr
    FROM e071
    INTO TABLE @lt_with_objects
    FOR ALL ENTRIES IN @lt_tasks
   WHERE trkorr = @lt_tasks-task.

  " Marca se a task tem objetos ou está vazia
  LOOP AT lt_tasks INTO ls_task.
    READ TABLE lt_with_objects
      WITH KEY table_line = ls_task-task
      TRANSPORTING NO FIELDS.

    IF sy-subrc = 0.
      ls_task-has_objects = 'X'.
    ELSE.
      CLEAR ls_task-has_objects.
    ENDIF.

    MODIFY lt_tasks FROM ls_task.
  ENDLOOP.

  " Cabeçalho do arquivo
  APPEND 'TASK;REQUEST_PAI;OWNER;TEM_OBJETO;DESCRICAO_TASK;DESCRICAO_REQUEST' TO lt_output.

  " Monta saída
  LOOP AT lt_tasks INTO ls_task.

    IF ls_task-has_objects = 'X'.
      lv_status = 'SIM'.
    ELSE.
      lv_status = 'NAO'.
    ENDIF.

    lv_line = |{ ls_task-task };{ ls_task-request };{ ls_task-owner };{ lv_status };{ ls_task-task_text };{ ls_task-request_text }|.

    APPEND lv_line TO lt_output.
  ENDLOOP.

  lv_fullpath = p_file.

  CALL METHOD cl_gui_frontend_services=>gui_download
    EXPORTING
      filename                = lv_fullpath
      filetype                = 'ASC'
    CHANGING
      data_tab                = lt_output
    EXCEPTIONS
      file_write_error        = 1
      no_batch                = 2
      gui_refuse_filetransfer = 3
      invalid_type            = 4
      no_authority            = 5
      unknown_error           = 6
      header_not_allowed      = 7
      separator_not_allowed   = 8
      filesize_not_allowed    = 9
      header_too_long         = 10
      dp_error_create         = 11
      dp_error_send           = 12
      dp_error_write          = 13
      unknown_dp_error        = 14
      access_denied           = 15
      dp_out_of_memory        = 16
      disk_full               = 17
      dp_timeout              = 18
      file_not_found          = 19
      dataprovider_exception  = 20
      control_flush_error     = 21
      OTHERS                  = 22.

  IF sy-subrc = 0.
    MESSAGE |{ lines( lt_tasks ) } tasks baixadas em { lv_fullpath }| TYPE 'S'.
  ELSE.
    MESSAGE 'Erro ao fazer download do arquivo.' TYPE 'E'.
  ENDIF.
